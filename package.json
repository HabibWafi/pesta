{
  "name": "pesta-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File db/backup.ps1",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:studio": "node --env-file=.env node_modules/drizzle-kit/bin.cjs studio",
    "db:sql": "node db/sql.mjs",
    "db:seed:konten": "node --env-file=.env --import tsx db/seed/content.mts",
    "db:seed:analitik": "node --env-file=.env --import tsx db/seed/analytics.mts",
    "cek:deploy": "node db/cek-deploy.mjs",
    "db:seed:beregam": "node --env-file=.env --import tsx db/seed/beregam.mts",
    "uji:beregam": "node db/uji/beregam.mjs",
    "uji:chunk": "node --import tsx db/uji/pemulihan-chunk.mts",
    "uji:bps": "node --import tsx db/uji/bps-api.mts",
    "perbaiki:nomor-lid": "node --env-file=.env --import tsx db/perbaiki/nomor-lid.mts",
    "cek:bps": "node --env-file=.env --import tsx db/cek-bps.mts",
    "buat:ikon": "node skrip/buat-ikon.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.27.0",
    "mysql2": "^3.23.4",
    "next": "^16.3.1",
    "postcss": "^8.5.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1"
  }
}
