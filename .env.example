# ==========================================================================
# CONTOH KONFIGURASI ENVIRONMENT — PESTA BPS Kabupaten Musi Rawas
#
# Salin berkas ini menjadi `.env` (lokal) atau isi lewat Environment Variables
# di hPanel Hostinger (produksi).
#
# JANGAN PERNAH menulis nilai rahasia yang sebenarnya di berkas ini.
# Berkas ini ikut ter-commit; `.env` dan `.env.production` tidak.
# ==========================================================================

# --- 1. Koneksi Database MySQL ---
# Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
#
# Development (Laragon di komputer ini):
#   DATABASE_URL="mysql://root@127.0.0.1:3306/pesta"
#
# Produksi (Hostinger):
DATABASE_URL="mysql://USER_DATABASE:PASSWORD_DATABASE@127.0.0.1:3306/NAMA_DATABASE"

# Alternatif Hostinger: bila hPanel hanya menyediakan variabel terpisah,
# kosongkan DATABASE_URL dan isi keempat variabel berikut. Aplikasi akan
# merangkainya sendiri (lihat src/lib/db/index.ts).
# DB_USER=
# DB_PASS=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=

# --- 2. Rahasia Sesi JWT Login Administrator ---
# WAJIB dibangkitkan sendiri, jangan menyalin nilai contoh dari mana pun:
#   openssl rand -hex 32
JWT_SECRET="GANTI_DENGAN_HASIL_openssl_rand_hex_32"

# --- 3. Runtime ---
NODE_ENV="production"
PORT=3000

# Zona waktu aplikasi. Semua waktu disimpan UTC di database dan
# dikonversi ke zona ini saat ditampilkan.
APP_TZ="Asia/Jakarta"

# --- 4. Peta lokasi kantor (Tahap 3) ---
# API key Google Maps Embed. Batasi HTTP referrer ke domain resmi.
# Bila dikosongkan, peta otomatis memakai OpenStreetMap.
GOOGLE_MAPS_EMBED_KEY=""
